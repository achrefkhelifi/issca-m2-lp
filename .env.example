# =============================================================================
# ISSCA Join (join.issca.tn) — Environment Configuration Example
# =============================================================================
# Copy this file to `.env.local` for Next.js frontend variables and `.dev.vars`
# for local Cloudflare Worker testing (`npx wrangler dev`).
# NEVER commit real secrets to version control.

# --- Public Frontend Analytics & Site Configuration ---
NEXT_PUBLIC_SITE_URL="https://join.issca.tn"
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA4_ID="G-JPB4GNGKL7"
NEXT_PUBLIC_META_PIXEL_ID=""

# --- Cloudflare Worker Server-Side Secrets (Configure via `wrangler secret put`) ---
# Webhook endpoint in n8n that creates/updates Odoo CRM leads and opportunities
N8N_WEBHOOK_URL="https://n8n.example.com/webhook/issca-master-admissions"
# Optional shared secret header (`X-Webhook-Secret`) to authenticate Worker -> n8n requests
N8N_WEBHOOK_SECRET=""

# Resend API for instant admissions team notifications
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
NOTIFICATION_EMAIL="contact@issca.tn"
RESEND_FROM_EMAIL="Admissions ISSCA <admissions@join.issca.tn>"

# Meta Conversions API (Server-side deduplicated events)
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
# Optional test event code for verifying in Meta Events Manager Test Events
META_TEST_EVENT_CODE=""

# Operational Mode ("development" allows local dry-run when N8N_WEBHOOK_URL is unset)
ENVIRONMENT="development"
